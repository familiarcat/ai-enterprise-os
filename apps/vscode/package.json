{
  "name": "sovereign-factory-vscode",
  "displayName": "Sovereign Factory",
  "description": "VSCode Extension for the Sovereign Factory AI Enterprise OS",
  "version": "0.0.1",
  "publisher": "familiarcat",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sovereign.runMission",
        "title": "Sovereign: Run Mission"
      },
      {
        "command": "sovereign.sensorSweep",
        "title": "Sovereign: Sensor Sweep"
      },
      {
        "command": "sovereign.healthCheck",
        "title": "Sovereign: Health Check"
      },
      {
        "command": "sovereign.checkBridgeStatus",
        "title": "Sovereign: Check Bridge Status"
      }
    ],
    "configuration": {
      "title": "Sovereign Factory",
      "properties": {
        "sovereign.mcpBridgeUrl": {
          "type": "string",
          "default": "http://localhost:3002",
          "description": "The URL of the Sovereign Factory MCP HTTP Bridge (sse/json-rpc)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sovereign-explorer",
          "title": "Sovereign Factory",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "sovereign-explorer": [
        {
          "type": "webview",
          "id": "sovereign.agentViewport",
          "name": "Agent Viewport"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run build:webview",
    "build:webview": "cd webview && npm run build",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3",
    "eslint": "^8.41.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8"
  }
}