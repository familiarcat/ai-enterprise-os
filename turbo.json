{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**", "dist/**", ".next/**", "media/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "compile": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    }
  }
}